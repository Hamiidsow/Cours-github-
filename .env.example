# Copier ce fichier vers .env.local puis renseigner les valeurs.
# Sans ces valeurs, le site démarre en MODE DÉMONSTRATION (annonces fictives,
# inscription et publication désactivées).

# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé PUBLIQUE (« publishable » ou « anon »). Elle est faite pour être exposée :
# la sécurité repose sur les politiques RLS de la base.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Adresse publique du site (liens de partage, sitemap, e-mails de confirmation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NE JAMAIS mettre ici la clé « service_role » / « secret » : l'application
# n'en a pas besoin et elle ne doit jamais se retrouver côté navigateur.
